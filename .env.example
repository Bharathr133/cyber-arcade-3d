# =============================================================================
# CYBER ARCADE 3D — 100% Zero-Client-Exposure Configuration
# =============================================================================
#
# 🔒 MAXIMUM ENTERPRISE SECURITY:
# Zero API keys, Zero database credentials, and Zero Webhook URLs are bundled
# into the client browser. All operations proxy through serverless /api/* endpoints.
# =============================================================================

# --- PRIVATE BACKEND SECRETS (Vercel Serverless / Node.js api/* ONLY) ---
# Supabase Database URL (Server-side only)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role / Admin Key (Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Private Discord Webhook for instant player bug reports & feedback (Server-side only)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Superadmin Security Passcode for /api/admin
ADMIN_SECRET=your_admin_secret_passcode_here
