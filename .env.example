# =============================================================================
# CYBER ARCADE 3D — Environment Variables Configuration
# =============================================================================
#
# IMPORTANT SECURITY NOTES:
# 1. ONLY public anonymous client keys (VITE_SUPABASE_ANON_KEY) should be placed here.
# 2. NEVER expose your service_role key, secret API tokens, or DB passwords in frontend code!
# 3. All database operations are secured via PostgreSQL Row-Level Security (RLS) & RPCs.
# =============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (Safe for client browsers with RLS enabled)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
